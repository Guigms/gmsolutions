generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @db.VarChar(36)
  name               String              @db.VarChar(120)
  email              String              @unique @db.VarChar(320)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  role               String              @default("user") @db.VarChar(30)
  createdAt          DateTime            @map("created_at") @db.DateTime(0)
  clients            Client[]
  payments           Payment[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Client {
  id           String    @id @db.VarChar(36)
  userId       String    @map("user_id") @db.VarChar(36)
  name         String    @db.VarChar(160)
  monthlyValue Decimal   @map("monthly_value") @db.Decimal(12, 2)
  dueDay       Int       @map("due_day")
  phone        String?   @db.VarChar(50)
  email        String?   @db.VarChar(320)
  notes        String?   @db.VarChar(1000)
  active       Boolean   @default(true)
  createdAt    DateTime  @map("created_at") @db.DateTime(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([userId])
  @@map("clients")
}

model Payment {
  id       String   @id @db.VarChar(36)
  userId   String   @map("user_id") @db.VarChar(36)
  clientId String   @map("client_id") @db.VarChar(36)
  year     Int
  month    Int
  amount   Decimal  @db.Decimal(12, 2)
  paidAt   DateTime @map("paid_at") @db.DateTime(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, year, month], map: "uq_payment_client_month")
  @@index([userId, year, month])
  @@index([clientId])
  @@map("payments")
}

model LoginAttempt {
  identifier String    @id @db.VarChar(400)
  count      Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.DateTime(0)

  @@map("login_attempts")
}

model PasswordResetToken {
  token     String   @id @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(36)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}